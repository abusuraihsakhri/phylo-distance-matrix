{
  "openapi": "3.1.0",
  "info": {
    "title": "Phylo Distance Matrix API",
    "description": "Nucleotide distance-matrix API with optional legacy generic supervisor endpoints.",
    "version": "3.0.0-ENTERPRISE",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus operational metrics",
        "responses": {
          "200": {
            "description": "Prometheus text metrics"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Air-gapped supervisory conversational assistant",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/matrix": {
      "post": {
        "summary": "Calculate p-distance, JC69 or K2P from aligned DNA FASTA",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "fasta"
                ],
                "properties": {
                  "fasta": {
                    "type": "string",
                    "description": "Aligned nucleotide FASTA, 2 MiB max"
                  },
                  "model": {
                    "type": "string",
                    "enum": [
                      "p",
                      "jc69",
                      "k2p"
                    ],
                    "default": "p"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ordered taxa, model, symmetric distance matrix"
          },
          "422": {
            "description": "Unaligned or invalid FASTA, zero comparable sites, saturation, or input too large"
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Serve local static matrix calculator",
        "responses": {
          "200": {
            "description": "HTML page"
          }
        }
      }
    },
    "/app.mjs": {
      "get": {
        "summary": "Serve standalone browser module",
        "responses": {
          "200": {
            "description": "JavaScript module"
          }
        }
      }
    }
  }
}
